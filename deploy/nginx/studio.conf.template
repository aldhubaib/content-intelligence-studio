# CI: nginx site for the hosted Content Intelligence Studio (ADR-058 §8).
# Rendered by the nginx image entrypoint with envsubst: ${PORT}, ${STUDIO_APP_ORIGIN}.

# The Studio fetches documents, fonts, media and the AI proxy from the app
# origin only; the editor renders with CanvasKit (wasm) and blob workers.
map $sent_http_content_type $studio_csp {
    default "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: ${STUDIO_APP_ORIGIN}; connect-src 'self' ${STUDIO_APP_ORIGIN}; worker-src 'self' blob:; media-src 'self' blob: ${STUDIO_APP_ORIGIN}; frame-ancestors ${STUDIO_APP_ORIGIN}; base-uri 'self'; form-action 'none'; object-src 'none'";
}

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Railway / Docker health probe — never cached, never logged.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        add_header Cache-Control "no-store";
        return 200 "ok\n";
    }

    # Render sidecar (Track E3c Part E). Only reachable from inside the Railway
    # project via the app's server-to-server call; the sidecar itself checks the
    # shared secret. Until the process exists nginx answers 502.
    location /internal/ {
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        client_max_body_size 32m;
    }

    # Hashed Vite output — immutable for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Content-Security-Policy $studio_csp always;
        try_files $uri =404;
    }

    # CanvasKit wasm + bundled fonts copied by vite/canvaskit-assets.
    location ~* \.(wasm|ttf|woff2?)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Content-Security-Policy $studio_csp always;
        try_files $uri =404;
    }

    # SPA shell — the document is chosen by URL parameters written by the app,
    # so index.html must never be served stale.
    location / {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy $studio_csp always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
        try_files $uri $uri/ /index.html;
    }

    # mime.types (inherited from nginx.conf) already maps .wasm → application/wasm;
    # .ttf falls back to application/octet-stream, which CanvasKit and @font-face accept.

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;
}
