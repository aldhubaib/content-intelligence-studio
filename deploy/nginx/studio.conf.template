# CI: nginx site for the hosted Content Intelligence Studio (ADR-058 §8).
# Rendered by the nginx image entrypoint with envsubst: ${PORT}, ${STUDIO_APP_ORIGIN}, ${STUDIO_RENDER_PORT}.

# The Studio fetches documents, fonts, media and the AI proxy from the app
# origin only; the editor renders with CanvasKit (wasm) and blob workers.
map $sent_http_content_type $studio_csp {
    default "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: ${STUDIO_APP_ORIGIN}; connect-src 'self' ${STUDIO_APP_ORIGIN}; worker-src 'self' blob:; media-src 'self' blob: ${STUDIO_APP_ORIGIN}; frame-ancestors ${STUDIO_APP_ORIGIN}; base-uri 'self'; form-action 'none'; object-src 'none'";
}

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Railway / Docker health probe — never cached, never logged. This is the
    # EDITOR's health: 200 as long as nginx serves `dist/`, whatever the renderer
    # is doing (S-11). The renderer is read separately at /healthz/render.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        add_header Cache-Control "no-store";
        return 200 "ok\n";
    }

    # S-11: the renderer's state without the bearer — proxied to the sidecar's
    # open `GET /healthz/render` ({ ok, renders, uptimeSec, inFlight, waiting });
    # while the sidecar is restarting the answer is 503 `render_unavailable`.
    location = /healthz/render {
        access_log off;
        proxy_pass http://127.0.0.1:${STUDIO_RENDER_PORT}/healthz/render;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store" always;
        error_page 502 504 =503 /healthz/render/unavailable;
    }

    location = /healthz/render/unavailable {
        internal;
        default_type application/json;
        add_header Retry-After "2" always;
        add_header Cache-Control "no-store" always;
        return 503 '{"ok":false,"error":"render_unavailable","message":"The renderer is restarting; retry shortly."}';
    }

    # Render sidecar (Track E3c Part E): `studio-render/server.ts` (Bun) in this
    # container on 127.0.0.1:${STUDIO_RENDER_PORT}. The app calls it server to
    # server with `Authorization: Bearer <STUDIO_INTERNAL_SECRET>`; the sidecar
    # verifies the value, nginx refuses anything without the header so the
    # embedded editor (same public origin) can never reach the renderer.
    #
    # S-11 / INC-18: the entrypoint restarts the sidecar whenever it exits
    # (recycle, exhaustion, crash). In between its socket is closed and nginx
    # would answer a bare 502 (or 504 past proxy_read_timeout); instead every
    # /internal/ answer in that window is 503 `render_unavailable` with
    # `Retry-After: 2` — the same body the sidecar sends while draining — so the
    # app's `studio` renderer defers the job without spending an attempt.
    # The sidecar's own 503s (render_busy, render_unavailable, not_configured)
    # pass through untouched: proxy_intercept_errors stays off.
    location = /internal/healthz {
        access_log off;
        proxy_pass http://127.0.0.1:${STUDIO_RENDER_PORT}/internal/healthz;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store" always;
        error_page 502 504 =503 /internal/unavailable;
    }

    location /internal/ {
        if ($http_authorization = "") {
            return 401 '{"error":"unauthorized","message":"Missing bearer."}';
        }
        proxy_pass http://127.0.0.1:${STUDIO_RENDER_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_request_buffering off;
        client_max_body_size 32m;
        add_header Cache-Control "no-store" always;
        error_page 502 504 =503 /internal/unavailable;
    }

    location = /internal/unavailable {
        internal;
        default_type application/json;
        add_header Retry-After "2" always;
        add_header Cache-Control "no-store" always;
        return 503 '{"error":"render_unavailable","message":"Render unavailable: the renderer is restarting; retry shortly."}';
    }

    # Hashed Vite output — immutable for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Content-Security-Policy $studio_csp always;
        try_files $uri =404;
    }

    # CanvasKit wasm + bundled fonts copied by vite/canvaskit-assets.
    location ~* \.(wasm|ttf|woff2?)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Content-Security-Policy $studio_csp always;
        try_files $uri =404;
    }

    # SPA shell — the document is chosen by URL parameters written by the app,
    # so index.html must never be served stale.
    location / {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy $studio_csp always;
        add_header Referrer-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
        try_files $uri $uri/ /index.html;
    }

    # mime.types (inherited from nginx.conf) already maps .wasm → application/wasm;
    # .ttf falls back to application/octet-stream, which CanvasKit and @font-face accept.

    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/wasm image/svg+xml;
    gzip_min_length 1024;
}
